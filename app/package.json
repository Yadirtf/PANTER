{
  "name": "@panter/app",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil de PANTER (pasajero y conductor) con Expo y Expo Router",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@panter/contracts": "workspace:*",
    "@panter/map-style": "workspace:*",
    "expo": "~58.0.24",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
