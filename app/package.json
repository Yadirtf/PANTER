{
  "name": "@panter/app",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil de PANTER (pasajero y conductor) con Expo y Expo Router",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@panter/contracts": "workspace:*",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
