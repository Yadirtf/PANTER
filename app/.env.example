# Copia este archivo como .env (o .env.local) y ajusta los valores.
# Expo carga .env automáticamente al ejecutar `expo start`, `expo prebuild` y `expo run:android`.

# Perfil de la app: development | staging | production
APP_ENV=development

# URL base de la API (Worker panter-api). Obligatoria y con https en staging y production.
# En development, si se omite, se usa http://localhost:8787.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Versión (las fija el CI: app.yml toma el tag app-vX.Y.Z y el número de ejecución).
# En local, si se omiten, se usan 0.1.0 y 1.
# APP_VERSION=0.1.0
# APP_VERSION_CODE=1

# URL de la web (opcional). Se muestra a los usuarios de personal, que solo usan la web.
# Si se omite: http://localhost:3000 en development; en staging y production se deduce de la API
# en workers.dev (panter-api-staging.<subdominio> → panter-web-staging.<subdominio>).
# EXPO_PUBLIC_WEB_URL=http://localhost:3000
