# Staging (Worker panter-web-staging). En CI estas variables se exportan antes de
# `pnpm deploy:staging`; en local copia este archivo a .env.production.local.
# Reemplaza <cuenta> por el subdominio workers.dev de la cuenta de Cloudflare.
NEXT_PUBLIC_API_URL=https://panter-api-staging.<cuenta>.workers.dev
NEXT_PUBLIC_APP_ENV=staging
