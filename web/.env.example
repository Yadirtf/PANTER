# Desarrollo local: copia este archivo a .env.local
# URL base de la API REST (Worker panter-api). Se incrusta en el bundle durante el build.
# También la usan el middleware y /api/session/* (servidor a servidor): login OTP, refresh,
# logout y el JWKS público (/.well-known/jwks.json) con el que se verifica el access token.
# La web no necesita secretos: no firma tokens, solo los verifica con la llave pública.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_ENV=development

# Staging (ver .env.staging.example):
#   NEXT_PUBLIC_API_URL=https://panter-api-staging.panter.workers.dev
# Producción (ver .env.production.example):
#   NEXT_PUBLIC_API_URL=https://panter-api.panter.workers.dev
