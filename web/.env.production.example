# Producción (Worker panter-web). En CI estas variables se exportan antes de
# `pnpm deploy:production`; en local copia este archivo a .env.production.local.
# Reemplaza <cuenta> por el subdominio workers.dev de la cuenta de Cloudflare.
NEXT_PUBLIC_API_URL=https://panter-api.<cuenta>.workers.dev
NEXT_PUBLIC_APP_ENV=production
