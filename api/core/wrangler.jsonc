// Worker panter-api (api-core). Especificación §3 y §10.
// - Nivel superior: entorno local (`wrangler dev`) y pruebas (@cloudflare/vitest-plugin).
// - env.staging → panter-api-staging · env.production → panter-api.
// Los bindings y las vars NO se heredan entre entornos en Wrangler: se repiten en cada uno.
// APP_VERSION y GIT_COMMIT valen "dev" por defecto; el despliegue los sobrescribe con
// `wrangler deploy --env <ambiente> --var APP_VERSION:<versión> --var GIT_COMMIT:<sha>`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "panter-api",
  "main": "src/index.ts",
  // Misma fecha que api/realtime y web. No puede superar la que soporta el workerd de
  // @cloudflare/vitest-plugin (miniflare 5.20261110.x); si no, las pruebas no arrancan.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "development",
    "APP_VERSION": "dev",
    "GIT_COMMIT": "dev",
  },
  // MARCADOR: reemplazar por el ID real (`wrangler kv namespace create panter-kv`).
  // En `wrangler dev` y en las pruebas el KV es simulado por Miniflare y el ID no importa.
  "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "panter-documents-dev" }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "panter-events-dev" }],
  },
  "services": [{ "binding": "REALTIME", "service": "panter-realtime" }],

  "env": {
    "staging": {
      "name": "panter-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "dev",
        "GIT_COMMIT": "dev",
      },
      // Namespace KV `panter-kv-staging`.
      "kv_namespaces": [{ "binding": "KV", "id": "94905b6be92b45a386fe5f4e8eeb9614" }],
      "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "panter-documents-staging" }],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "panter-events-staging" }],
      },
      "services": [{ "binding": "REALTIME", "service": "panter-realtime-staging" }],
    },
    "production": {
      "name": "panter-api",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "dev",
        "GIT_COMMIT": "dev",
      },
      // MARCADOR: ID real del namespace KV de producción (pendiente de cuenta de Cloudflare).
      "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000002" }],
      "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "panter-documents" }],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "panter-events" }],
      },
      "services": [{ "binding": "REALTIME", "service": "panter-realtime" }],
    },
  },
}
