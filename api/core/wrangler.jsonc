// Worker panter-api (api-core). Especificación §3 y §10.
// - Nivel superior: entorno local (`wrangler dev`) y pruebas (@cloudflare/vitest-plugin).
// - env.staging → panter-api-staging · env.production → panter-api.
// Los bindings y las vars NO se heredan entre entornos en Wrangler: se repiten en cada uno.
// APP_VERSION y GIT_COMMIT valen "dev" por defecto; el despliegue los sobrescribe con
// `wrangler deploy --env <ambiente> --var APP_VERSION:<versión> --var GIT_COMMIT:<sha>`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "panter-api",
  "main": "src/index.ts",
  // Misma fecha que api/realtime y web. No puede superar la que soporta el workerd de
  // @cloudflare/vitest-plugin (miniflare 5.20261110.x); si no, las pruebas no arrancan.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "development",
    "APP_VERSION": "dev",
    "GIT_COMMIT": "dev",
    // Orígenes web autorizados por CORS (separados por comas). Local: next dev.
    "CORS_ORIGINS": "http://localhost:3000",
    // Correo (HU-102). Secretos aparte: BREVO_API_KEY, RESEND_API_KEY (Docs/GUIA-DESPLIEGUE.md).
    "EMAIL_PROVIDER": "brevo",
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": "PANTER",
    // OTP_DEV_ECHO solo tiene efecto con ENVIRONMENT=staging (y la lista OTP_DEV_ECHO_ALLOWLIST).
    "OTP_DEV_ECHO": "false",
    // kid de la llave JWT (HU-103). Llaves en los secretos JWT_PRIVATE_KEY y JWT_PUBLIC_KEY.
    "JWT_KID": "panter-dev",
  },
  // MARCADOR: reemplazar por el ID real (`wrangler kv namespace create panter-kv`).
  // En `wrangler dev` y en las pruebas el KV es simulado por Miniflare y el ID no importa.
  "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "panter-documents-dev" }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "panter-events-dev" }],
  },
  "services": [{ "binding": "REALTIME", "service": "panter-realtime" }],

  "env": {
    "staging": {
      "name": "panter-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_VERSION": "dev",
        "GIT_COMMIT": "dev",
        "CORS_ORIGINS": "https://panter-web-staging.panter.workers.dev,http://localhost:3000",
        "EMAIL_PROVIDER": "brevo",
        // MARCADOR: correo verificado como remitente en Brevo (Senders). Vacío = el login falla
        // con un error claro en los logs; /health sigue funcionando.
        "EMAIL_FROM": "",
        "EMAIL_FROM_NAME": "PANTER",
        // Eco del OTP en los logs para los correos del secreto OTP_DEV_ECHO_ALLOWLIST.
        "OTP_DEV_ECHO": "true",
        // kid de la llave JWT; cambiarlo al rotar las llaves (scripts/generar_llaves_jwt.sh).
        "JWT_KID": "panter-staging-1",
      },
      // Namespace KV `panter-kv-staging`.
      "kv_namespaces": [{ "binding": "KV", "id": "94905b6be92b45a386fe5f4e8eeb9614" }],
      "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "panter-documents-staging" }],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "panter-events-staging" }],
      },
      "services": [{ "binding": "REALTIME", "service": "panter-realtime-staging" }],
    },
    "production": {
      "name": "panter-api",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "dev",
        "GIT_COMMIT": "dev",
        "CORS_ORIGINS": "https://panter-web.panter.workers.dev",
        "EMAIL_PROVIDER": "brevo",
        // MARCADOR: remitente de producción (con dominio propio, no-reply@mail.<dominio>).
        "EMAIL_FROM": "",
        "EMAIL_FROM_NAME": "PANTER",
        // Imposible en production aunque valga "true": el código exige ENVIRONMENT=staging.
        "OTP_DEV_ECHO": "false",
        "JWT_KID": "panter-production-1",
      },
      // MARCADOR: ID real del namespace KV de producción (pendiente de cuenta de Cloudflare).
      "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000002" }],
      "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "panter-documents" }],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "panter-events" }],
      },
      "services": [{ "binding": "REALTIME", "service": "panter-realtime" }],
    },
  },
}
