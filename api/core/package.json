{
  "name": "@panter/api-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker panter-api: API REST de PANTER (Hono)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@neondatabase/serverless": "^1.2.0",
    "@panter/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "postgres": "^3.4.9",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
